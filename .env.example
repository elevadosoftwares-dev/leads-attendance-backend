# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (mobile apps don't send Origin and are always allowed)
CORS_ORIGINS=http://localhost:3000
# Set to the number of reverse proxies in front of the app (e.g. 1 behind IIS/nginx) so req.ip is correct
TRUST_PROXY=0
LOG_LEVEL=info

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# Optional named instance (e.g. SQLEXPRESS); leave empty for the default instance
DB_INSTANCE=
DB_NAME=LeadsAttendance
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=true
# Dev only: trust self-signed SQL Server certificates
DB_TRUST_SERVER_CERT=true
# Database used by `npm test` (dropped and recreated on every run; must end with _test)
TEST_DB_NAME=LeadsAttendance_test

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Business rules ---
# Fallback company timezone, used until the office has been read at startup. The super admin sets the real one
# in Office Settings (stored on the office).
APP_TIMEZONE=Asia/Singapore
MAX_GPS_ACCURACY_METERS=50
CLOCK_OUT_REQUIRES_GEOFENCE=false

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Push notifications (optional; push is a logged no-op when unset) ---
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Mail (optional; reset links are logged to the console when SMTP_HOST is unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LEADS Attendance <no-reply@leads-ndt.com>
# Base URL used in password-reset emails (defaults to PUBLIC_BASE_URL)
PASSWORD_RESET_URL=

# --- Background jobs ---
ENABLE_CRON=true

# Super admin created by `npm run seed` (the seed wipes all data). Without a password one is generated and printed.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@leads-ndt.com
SUPERADMIN_PASSWORD=
