<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS as a reverse proxy in front of the Node service listening on localhost:4000.
  Requires: URL Rewrite, Application Request Routing (proxy enabled), WebSocket Protocol feature.
  Put this file, renamed to web.config, alone in an empty folder and point the IIS site there. Never point the
  site at the project folder: IIS could then serve files such as secrets/*.json directly.
  Run Node with TRUST_PROXY=1, or every client shares the proxy's IP and therefore one login rate limit.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" /> <!-- let ARR pass WebSocket upgrades through to Node -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Slightly above MAX_UPLOAD_MB (10 MB) so Node can return a proper validation error. -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
