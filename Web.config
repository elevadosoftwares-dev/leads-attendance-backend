<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode hosting for the LEADS Attendance API, with the site's physical path set to this folder.
  After every code change: npm run build, then restart the site (or touch iisnode-server.js).
-->
<configuration>
  <system.webServer>
    <!-- Lets iisnode handle WebSocket upgrades itself (Socket.IO /admin). -->
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="iisnode-server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Every request goes to Node. No file in this folder is ever served directly. -->
        <rule name="LeadsApi" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode-server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="secrets" />
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="dist" />
          <add segment="db" />
          <add segment="uploads" />
          <add segment="iisnode" />
          <add segment=".git" />
        </hiddenSegments>
        <!-- Slightly above MAX_UPLOAD_MB (10 MB) so Node can return a proper validation error. -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>

    <!-- Node returns its own JSON errors; stop IIS replacing them with HTML pages. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode
      node_env="production"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      enableXFF="true"
      watchedFiles="web.config;iisnode-server.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      debuggingEnabled="false"
    />
  </system.webServer>
</configuration>
